# Copy to .env and adjust for local use. Northstar reads these as
# plain OS environment variables (see api/dependencies.py,
# api/main.py) -- this file is a reference for what to set, not
# something the app loads automatically. Never commit a real .env.

# Where SQLite persists Quotes/Proposals/negotiation state. Defaults
# to data/northstar.db (repo-relative) if unset. In production, point
# this at a persistent volume -- container-local storage does not
# survive a redeploy (see docs/DEPLOYMENT.md).
NORTHSTAR_DB_PATH=data/northstar.db

# "production" makes api/main.py serve the built React SPA
# (frontend/dist) same-origin and skips the dev-only CORS allowance.
# Anything else (including unset) is development.
NORTHSTAR_ENV=development

# Port uvicorn binds to in production (see Dockerfile). Not read by
# `npm run dev`, which always uses 8000/5173.
PORT=8000
